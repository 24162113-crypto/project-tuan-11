<%@ page pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fn" uri="jakarta.tags.functions" %>
<c:set var="ctx" value="${pageContext.request.contextPath}"/>
<%-- URI gốc của request (SiteMesh có thể forward sang decorator) để đánh dấu menu đang chọn --%>
<c:set var="reqUri" value="${not empty requestScope['jakarta.servlet.forward.request_uri'] ? requestScope['jakarta.servlet.forward.request_uri'] : pageContext.request.requestURI}"/>
<c:set var="navHome" value="${fn:endsWith(reqUri, '/home') or fn:endsWith(reqUri, '/')}"/>
<c:set var="navVideo" value="${fn:endsWith(reqUri, '/video')}"/>

<!-- BEGIN TOP BAR -->
<div class="pre-header">
  <div class="container">
    <div class="row">
      <div class="col-md-6 col-sm-6 hidden-xs additional-shop-info">
        <ul class="list-unstyled list-inline">
          <li><i class="fa fa-play-circle"></i><span>Nền tảng chia sẻ video</span></li>
        </ul>
      </div>
      <div class="col-md-6 col-sm-6 col-xs-12 additional-nav">
        <ul class="list-unstyled list-inline pull-right">
          <li><a href="${ctx}/cart"><i class="fa fa-shopping-cart"></i> Giỏ hàng (${empty sessionScope.cart ? 0 : sessionScope.cart.totalQuantity})</a></li>
          <c:choose>
            <c:when test="${empty sessionScope.currentUser}">
              <li><a href="${ctx}/login">Đăng nhập</a></li>
              <li><a href="${ctx}/register">Đăng ký</a></li>
            </c:when>
            <c:otherwise>
              <li class="hello"><i class="fa fa-user"></i> Xin chào, <strong><c:out value="${sessionScope.currentUser.fullname}"/></strong></li>
              <li><a href="${ctx}/orders">Đơn hàng</a></li>
              <li><a href="${ctx}/logout">Đăng xuất</a></li>
            </c:otherwise>
          </c:choose>
        </ul>
      </div>
    </div>
  </div>
</div>
<!-- END TOP BAR -->

<!-- BEGIN HEADER -->
<div class="header">
  <div class="container">
    <a class="site-logo" href="${ctx}/home"><i class="fa fa-play-circle"></i>VideoShare</a>
    <a href="javascript:void(0);" class="mobi-toggler"><i class="fa fa-bars"></i></a>

    <!-- BEGIN NAVIGATION -->
    <div class="header-navigation">
      <ul>
        <li class="${navHome ? 'active' : ''}"><a href="${ctx}/home">Trang chủ</a></li>
        <li class="${navVideo ? 'active' : ''}"><a href="${ctx}/home#san-pham">Sản phẩm</a></li>
        <c:if test="${sessionScope.currentUser.admin}">
          <li><a href="${ctx}/admin/home">Trang quản trị</a></li>
        </c:if>
      </ul>
    </div>
    <!-- END NAVIGATION -->
  </div>
</div>
<!-- END HEADER -->
