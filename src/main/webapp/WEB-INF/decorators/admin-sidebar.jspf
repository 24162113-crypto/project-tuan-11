<%@ page pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fn" uri="jakarta.tags.functions" %>
<c:set var="ctx" value="${pageContext.request.contextPath}"/>
<c:set var="adminUri" value="${not empty requestScope['jakarta.servlet.forward.request_uri'] ? requestScope['jakarta.servlet.forward.request_uri'] : pageContext.request.requestURI}"/>
<c:set var="menuVideos" value="${fn:contains(adminUri, '/admin/videos')}"/>
<c:set var="menuHome" value="${fn:endsWith(adminUri, '/admin/home') or fn:endsWith(adminUri, '/admin') or fn:endsWith(adminUri, '/admin/')}"/>
<!-- BEGIN SIDEBAR -->
<div class="page-sidebar-wrapper">
  <div class="page-sidebar navbar-collapse collapse">
    <ul class="page-sidebar-menu" data-keep-expanded="false" data-auto-scroll="true" data-slide-speed="200">
      <li class="sidebar-toggler-wrapper">
        <div class="sidebar-toggler"></div>
      </li>
      <li class="start ${menuHome ? 'active' : ''}">
        <a href="${ctx}/admin/home">
          <i class="icon-home"></i>
          <span class="title">Bảng điều khiển</span>
          <c:if test="${menuHome}"><span class="selected"></span></c:if>
        </a>
      </li>
      <li class="${menuVideos ? 'active' : ''}">
        <a href="${ctx}/admin/videos">
          <i class="icon-film"></i>
          <span class="title">Quản lý Video</span>
          <c:if test="${menuVideos}"><span class="selected"></span></c:if>
        </a>
      </li>
      <li class="last">
        <a href="${ctx}/home">
          <i class="icon-globe"></i>
          <span class="title">Xem trang người dùng</span>
        </a>
      </li>
    </ul>
  </div>
</div>
<!-- END SIDEBAR -->
